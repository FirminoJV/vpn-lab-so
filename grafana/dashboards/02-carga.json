{
 "uid": "02-carga",
 "title": "VPN Lab — 2. Carga e capacidade dos túneis",
 "description": "O que acontece quando muitos usuários usam o mesmo túnel/servidor ao mesmo tempo.",
 "tags": [
  "vpnlab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "servidor",
    "label": "Servidor",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "query": {
     "query": "label_values(vpnlab_node_info{role=\"server\"}, node)",
     "refId": "v"
    },
    "definition": "label_values(vpnlab_node_info{role=\"server\"}, node)",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
