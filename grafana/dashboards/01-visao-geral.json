  {
   "type": "table",
   "title": "RTT pelo túnel (ms)",
   "description": "Ida e volta, medido pela VPN de cada usuário até cada servidor",
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(vpnlab_probe_rtt_avg_ms{path=\"tunnel\"}[2m])",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "dst",
      "rowField": "src",
      "valueField": "Value",
      "emptyValue": "null"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 1,
     "color": {
      "mode": "continuous-GrYlRd"
     },
     "custom": {
      "align": "center",
      "cellOptions": {
       "type": "color-background",
       "mode": "gradient"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^src.*"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       },
       {
        "id": "custom.align",
        "value": "left"
       }
      ]
     }
    ]
   },
