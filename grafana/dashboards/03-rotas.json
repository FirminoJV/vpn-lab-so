  {
   "type": "table",
   "title": "Rotas onde o relay ganha do caminho direto",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(vpnlab_opt_route_gain_ms > 1)",
     "instant": true,
     "format": "table"
