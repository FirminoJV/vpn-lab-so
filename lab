#!/usr/bin/env bash
# VPN Lab — ponto de entrada único. Só precisa de Docker (com o plugin compose).
set -euo pipefail
cd "$(dirname "$0")"
COMPOSE=(docker compose -f build/compose.yml)
GRAFANA_PORT=$(grep -E '^grafana_port' topology.toml | grep -oE '[0-9]+' || echo 3000)
PROM_PORT=$(grep -E '^prometheus_port' topology.toml | grep -oE '[0-9]+' || echo 9090)

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[aviso]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[erro]\033[0m %s\n' "$*"; exit 1; }

check() {
  command -v docker >/dev/null || fail "Docker não encontrado. Instale: https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 || fail "plugin 'docker compose' não encontrado (pacote docker-compose-plugin)"
  docker info >/dev/null 2>&1 || fail "sem acesso ao Docker. Rode com sudo ou adicione seu usuário ao grupo docker"
  [ "$(nproc)" -ge 4 ] || warn "menos de 4 núcleos: os limites de CPU não serão garantidos e a vazão pode divergir"
  [ "$(uname -s)" = Linux ] || warn "feito para Linux; em outros sistemas a emulação de rede pode não funcionar"
  # módulos podem estar embutidos no kernel (WSL2, por exemplo): tenta carregar, sem reclamar
  for m in wireguard sch_netem sch_htb cls_u32 act_police; do
    sudo -n modprobe "$m" 2>/dev/null || modprobe "$m" 2>/dev/null || true
  done
  if grep -qi microsoft /proc/version 2>/dev/null; then say "rodando no WSL2 do Windows"; fi
  if [ "${1:-}" != quiet ] && docker image inspect vpnlab-node:latest >/dev/null 2>&1; then
    if netem_ok; then say "emulação de rede (netem) funcionando"; else warn "o kernel NÃO aceitou o netem (veja Problemas comuns no GUIA.md)"; fi
  fi
  local mem; mem=$(awk '/MemTotal/{print int($2/1024/1024)}' /proc/meminfo 2>/dev/null || echo 0)
  say "Docker ok · RAM ${mem} GB · $(nproc) núcleos"
}

netem_ok() {   # teste real: o kernel aceita atraso emulado dentro de um contêiner?
  docker image inspect vpnlab-node:latest >/dev/null 2>&1 || return 1
  docker run --rm --cap-add NET_ADMIN --network none vpnlab-node:latest \
    tc qdisc add dev lo root netem delay 1ms >/dev/null 2>&1
}

build() {
  [ "${VPNLAB_NO_BUILD:-0}" = 1 ] && return 0
  say "construindo imagens (só na primeira vez demora)"
  docker build -q -t vpnlab-node:latest node/ >/dev/null
  docker build -q -t vpnlab-ctl:latest ctl/ >/dev/null
}

gen() {
  say "gerando configuração a partir de topology.toml"
  docker run --rm --user "$(id -u):$(id -g)" -v "$PWD":/lab -w /lab vpnlab-ctl:latest python gen/gen.py
}

ctl() { "${COMPOSE[@]}" run --rm --quiet-pull -e HOST_NAME="$(hostname)" --user "$(id -u):$(id -g)" ctl "$@" 2> >(grep -v -E '^ *(Container|Network) ' >&2); }

case "${1:-help}" in
  check) check ;;
  up)
    check quiet; build
    if netem_ok; then say "emulação de rede (netem) funcionando"
    else warn "o kernel NÃO aceitou o netem: as latências da 'internet' simulada não serão aplicadas."
         if grep -qi microsoft /proc/version; then warn "WSL2: no PowerShell do Windows rode  wsl --update  e depois  wsl --shutdown ; abra o Ubuntu de novo"
         else warn "Ubuntu: sudo apt install linux-modules-extra-\$(uname -r) && sudo modprobe -a sch_netem sch_htb  — depois ./lab down && ./lab up"; fi
    fi
    gen
    mkdir -p results
    say "subindo o laboratório"
    "${COMPOSE[@]}" up -d --remove-orphans
    say "aguardando os primeiros handshakes e medições (~40 s)"
    sleep 40
    ctl status || true
    echo
    say "Grafana:    http://localhost:${GRAFANA_PORT}   (dashboards em 'VPN Lab')"
    say "Prometheus: http://localhost:${PROM_PORT}"
    say "Próximos passos: ./lab matrix · ./lab optimize · ./lab ramp --server srv-fra · ./lab report"
    ;;
  env)   # registra a máquina usada, para anexar aos resultados
    mkdir -p results; f="results/ambiente-$(hostname)-$(date +%Y%m%d-%H%M%S).txt"
    { echo "data: $(date -Iseconds)"; echo "host: $(hostname)"; echo "kernel: $(uname -r)"
      echo "cpu: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs) ($(nproc) núcleos)"
      echo "ram: $(awk '/MemTotal/{printf "%.1f GB", $2/1048576}' /proc/meminfo)"
      echo "docker: $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
      echo "compose: $(docker compose version --short 2>/dev/null)"
      echo "versao do lab (git): $(git rev-parse --short HEAD 2>/dev/null || echo sem-git)"
      echo "topology.toml sha256: $(sha256sum topology.toml | cut -c1-16)"
      echo "emulacao de rede (netem): $(netem_ok && echo funciona || echo NAO FUNCIONA)"
    } | tee "$f"; say "salvo em $f" ;;
  gen) build; gen ;;
  apply)   # regenera e recria só o que mudou, mantendo o histórico do Prometheus
    build; gen; "${COMPOSE[@]}" up -d --remove-orphans; "${COMPOSE[@]}" restart prometheus optimizer ;;
  down)
    if [ "${2:-}" = "--all" ]; then "${COMPOSE[@]}" down -v; else "${COMPOSE[@]}" down; fi ;;
  ps) "${COMPOSE[@]}" ps ;;
  logs) shift; "${COMPOSE[@]}" logs -f --tail 100 "$@" ;;
  shell) [ -n "${2:-}" ] || fail "uso: ./lab shell <nó>   ex.: ./lab shell cli-sao-1"
         docker exec -it "vpnlab-$2" sh ;;
  test)
    build
    docker run --rm -v "$PWD":/lab -w /lab vpnlab-ctl:latest sh -c "python gen/gen.py >/dev/null && python tests/test_optimizer.py" ;;
  report)
    shift; ctl report "$@"
    say "abra: results/relatorio-mais-recente.html" ;;
  status|matrix|optimize|load|ramp|abuse|impair|reset|medir) ctl "$@" ;;
  help|-h|--help|*)
    cat <<'EOF'
VPN Lab — laboratório fechado de medição de VPN

  ./lab check                      verifica Docker e módulos do kernel
  ./lab up                         constrói, gera e sobe tudo
  ./lab down [--all]               para (--all apaga também o histórico)
  ./lab apply                      aplica mudanças do topology.toml
  ./lab status                     túneis, handshakes, emulação, sondas
  ./lab matrix [--path underlay] [--metric rtt|p95|jitter|loss]
  ./lab optimize [--objective media|pior_caso|mos]
  ./lab load   --server srv-fra [--clients all|region:sao|N|cli-a,cli-b] [--rate 20M] [--proto udp]
  ./lab ramp   --server srv-fra [--steps 1,2,4,8,12,18] [--duration 25]
  ./lab abuse  --server srv-fra --heavy cli-sao-1 [--normal 6]
  ./lab impair --node srv-fra --dst srv-sin --add-delay-ms 150 [--loss-pct 5] [--down] [--both]
  ./lab reset                      remove todas as falhas
  ./lab medir latencia|vazao|perda protocolo do grupo (0/2/8/18 usuários, 3 repetições)
  ./lab report                     relatório HTML em results/
  ./lab shell cli-sao-1            terminal dentro de uma máquina
  ./lab logs srv-fra               logs de um nó
  ./lab test                       testes automáticos
  ./lab env                        registra a máquina usada (anexe aos resultados)

Cada comando aceita --help.
EOF
    ;;
esac
